---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, getCollection, render } from 'astro:content';

const homeEntry = await getEntry('pages', 'home');
const { Content: HomeContent } = await render(homeEntry);

const shortEssays = await getCollection('shortEssays', ({ data }) => !data.draft);
shortEssays.sort((a, b) => a.data.number - b.data.number);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Shades of Singularity',
  description: homeEntry.data.description,
  url: 'https://shadesofsingularity.com',
};
---

<BaseLayout
  title="Shades of Singularity"
  description={homeEntry.data.description}
  jsonLd={jsonLd}
>
  <section class="home-hero">
    <div class="content-column">
      <h1 class="home-title">Shades of Singularity</h1>
      <blockquote class="home-epigraph">
        "Most of the threats we face come from the progress we've made in science and technology. We are not going to stop making progress, or reverse it, so we must recognize the dangers and control them."
        <cite>Stephen Hawking, BBC Radio Times, January 2016</cite>
      </blockquote>
    </div>
  </section>

  <section class="home-premise">
    <div class="content-column">
      <HomeContent />
    </div>
  </section>

  <!-- How This Collection Works -->
  <section class="home-guide">
    <div class="content-column">
      <h2 class="section-heading">How This Collection Works</h2>
      <p>The collection is built in three layers, each serving a different purpose.</p>

      <div class="pillar-grid">
        <a href="/short-essays/" class="pillar-card">
          <h3 class="pillar-title">Short Essays</h3>
          <p class="pillar-description">Start here. Each short essay makes one argument about the AI transformation in about ten minutes of reading. No footnotes, no sources.</p>
        </a>

        <a href="/essays/" class="pillar-card">
          <h3 class="pillar-title">Full Essays</h3>
          <p class="pillar-description">Go deeper. Each full essay is the complete analysis of one dimension of the AI transformation: sourced, footnoted, with counterarguments engaged and three branching futures traced.</p>
        </a>

        <a href="/shades/" class="pillar-card">
          <h3 class="pillar-title">The Shades</h3>
          <p class="pillar-description">The evidence base. Each shade isolates one variable of the AI future, scores it on likelihood and outcome, and traces where it points.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- The Arguments -->
  <section class="home-essays">
    <div class="content-column">
      <h2 class="section-heading">The Arguments</h2>

      <div class="essay-list">
        {shortEssays.map((entry) => (
          <div class="essay-summary-card">
            <span class="essay-summary-numeral">{entry.data.numeral}</span>
            <h3 class="essay-summary-title">
              <a href={`/short-essays/${entry.data.slug}/`}>{entry.data.title}</a>
            </h3>
            <p class="essay-summary-subtitle">{entry.data.subtitle}</p>
            <div class="essay-summary-actions">
              <a href={`/short-essays/${entry.data.slug}/`} class="read-essay-link">Read the essay &rarr;</a>
              <a href={`/essays/${entry.data.fullEssaySlug}/`} class="full-length-link">Full-length version</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .home-hero {
    padding: var(--space-xl) 0 var(--space-lg);
  }

  .home-title {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 0.75em;
    text-align: center;
  }

  .home-epigraph {
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    font-style: italic;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 36em;
    margin: 0 auto;
    border: none;
    padding: 0;
  }

  .home-epigraph cite {
    display: block;
    margin-top: 0.5em;
    font-size: var(--font-size-sm);
    font-style: normal;
    color: var(--color-text-muted);
  }

  .home-premise {
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  .section-heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-xl);
    text-align: center;
    margin-bottom: var(--space-md);
  }

  .home-guide {
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .home-guide > .content-column > p {
    text-align: center;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .pillar-card {
    padding: 1.25rem;
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .pillar-card:hover {
    border-color: var(--color-accent);
    background-color: var(--color-accent-muted);
  }

  .pillar-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-accent);
  }

  .pillar-description {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .home-essays {
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .essay-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .essay-summary-card {
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .essay-summary-card:last-child {
    border-bottom: none;
  }

  .essay-summary-numeral {
    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }

  .essay-summary-title {
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: 600;
    line-height: var(--line-height-heading);
    margin: 0.25em 0;
  }

  .essay-summary-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .essay-summary-title a:hover {
    color: var(--color-accent);
  }

  .essay-summary-subtitle {
    font-family: var(--font-body);
    font-style: italic;
    color: var(--color-text-muted);
    margin-bottom: 0.5em;
  }

  .essay-summary-actions {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: 0.5em;
    flex-wrap: wrap;
  }

  .read-essay-link {
    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .read-essay-link:hover {
    text-decoration: underline;
  }

  .full-length-link {
    font-family: var(--font-body);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid var(--color-rule);
    padding: 0.35em 0.75em;
    border-radius: 3px;
    transition: border-color 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }

  .full-length-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .essay-placeholder {
    opacity: 0.55;
  }

  .coming-soon-tag {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-left: 0.75em;
    vertical-align: middle;
  }

  @media (max-width: 768px) {
    .pillar-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
