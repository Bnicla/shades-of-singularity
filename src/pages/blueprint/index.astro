---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="The Blueprint"
  description="Institutional mechanisms for the AI transition. Currently in development."
>
  <div class="content-column" style="padding-top: var(--space-xl); padding-bottom: var(--space-xl); text-align: center;">
    <h1 class="blueprint-title">The Blueprint</h1>
    <p class="blueprint-message">
      The Blueprint section is currently in development. It will synthesize the institutional responses proposed across all six essays into specific mechanisms for governance, distribution, and democratic renewal. Check back soon.
    </p>
  </div>
</BaseLayout>

<style>
  .blueprint-title {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-md);
  }

  .blueprint-message {
    font-size: var(--font-size-base);
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 36em;
    margin: 0 auto;
  }
</style>
